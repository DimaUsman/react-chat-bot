# =============================================================================
# Куда указывать креды PostgreSQL
# =============================================================================
# 1. Скопируйте этот файл:  copy .env.example .env
# 2. Правьте ТОЛЬКО .env (он в .gitignore, в git не попадёт)
# 3. docker compose (Postgres) и Dockerfile.api (API) читают переменные отсюда
# =============================================================================

# --- Docker Postgres (docker-compose.yml) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

# --- Backend API ---
# На хосте (npm run dev:server) и в контейнере API (Dockerfile.api):
# host.docker.internal — доступ к Postgres на машине из контейнера (Docker Desktop).
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot
# PostgreSQL schema (не public). По умолчанию dataoffice_chat_bot
DATABASE_SCHEMA=dataoffice_chat_bot

PORT=3001
CORS_ORIGIN=http://localhost:5173
# Прод: origin системы отчётов, например https://reports.example.com
# CORS_ORIGIN=https://reports.example.com

# TTL гостевой сессии (дни)
VISITOR_TTL_DAYS=14

# Seed: логины поддержки через запятую (для тестов)
SUPPORT_LOGINS=support,admin

# --- Pachca (уведомления поддержке) ---
# Входящий webhook бота Пачки. Если пусто — уведомления не отправляются.
PACHCA_WEBHOOK_URL=

# Публичный URL админки (для картинок отчётов в чате)
ADMIN_PUBLIC_URL=http://localhost:3002

# --- Admin panel ---
ADMIN_PORT=3002
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-me-admin-secret
