# =============================================================================
# Куда указывать креды PostgreSQL
# =============================================================================
# 1. Скопируйте этот файл:  copy .env.example .env
# 2. Правьте ТОЛЬКО .env (он в .gitignore, в git не попадёт)
# 3. Контейнеры читают переменные через: docker run --env-file .env
#    (файла .env внутри образа нет — только то, что передали в -e / --env-file)
# =============================================================================

# --- Postgres: либо одна строка DATABASE_URL, либо отдельные поля ---
# Вариант A (предпочтительно для прода):
DATABASE_URL=postgresql://USER:PASSWORD@PG_HOST:5432/DB_NAME

# Вариант B: если DATABASE_URL пустой, URL собирается из:
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot

# PostgreSQL schema (не public)
DATABASE_SCHEMA=dataoffice_chat_bot
# FORCE_MIGRATE=1  — применить schema.sql при старте (нужны права владельца схемы)

# Порт API внутри контейнера (Dockerfile.api → ENV PORT)
# Не путать с ADMIN_PORT: общий --env-file .env уходит в оба контейнера
PORT=3001
# Origin Luxms (как в адресной строке браузера), через запятую; * — отладка
CORS_ORIGIN=http://192.168.235.8
# CORS_ORIGIN=http://192.168.235.8,http://192.168.235.8:8080
# CORS_ORIGIN=*

# TTL гостевой сессии (дни)
VISITOR_TTL_DAYS=14

# Seed: логины поддержки через запятую (для тестов)
SUPPORT_LOGINS=support,admin

# --- Pachca (уведомления поддержке) ---
PACHCA_WEBHOOK_URL=

# Публичный URL админки (для картинок отчётов в чате)
ADMIN_PUBLIC_URL=http://localhost:3002

# --- Admin panel ---
# Порт админки (приоритетнее PORT из этого же файла)
ADMIN_PORT=3002
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-me-admin-secret
