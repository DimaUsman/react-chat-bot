# Отдельный образ API.
# Сборка:  docker build -f Dockerfile.api -t react-chat-bot-api ./server
# Запуск:  docker run -d --name react-chat-bot-api -p ${PORT:-3001}:${PORT:-3001} --env-file .env react-chat-bot-api
#
# Порт задаётся переменной PORT (из .env / -e PORT=...).

FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

COPY db ./db
COPY src ./src

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE ${PORT}

CMD ["node", "src/index.js"]
