# Отдельный образ админ-панели.
# Сборка:  docker build -f Dockerfile.admin -t react-chat-bot-admin .
# Запуск:  docker run -d --name react-chat-bot-admin -p ${ADMIN_PORT:-3002}:${ADMIN_PORT:-3002} --env-file .env -v ... react-chat-bot-admin
#
# Порт задаётся ADMIN_PORT (или PORT). Приоритет в приложении: PORT → ADMIN_PORT → 3002.

FROM node:24-alpine

WORKDIR /app

COPY admin/package.json admin/package-lock.json* ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

COPY admin/src ./src
COPY admin/public ./public
COPY server/db/schema.sql ./db/schema.sql
COPY server/db/recreate_schema.sql ./db/recreate_schema.sql
RUN mkdir -p uploads

ENV NODE_ENV=production
ENV ADMIN_PORT=3002
ENV PORT=3002

EXPOSE ${ADMIN_PORT}

CMD ["node", "src/index.js"]
